# Copy to ski-brief.env and fill in. Never commit the real file.

# Discord developer portal -> New Application -> Bot -> Reset Token. Invite it with the
# "bot" + "applications.commands" scopes (OAuth2 -> URL Generator), permissions: Send Messages, Embed Links.
DISCORD_BOT_TOKEN=

# Claude API key from console.anthropic.com. Without it the bot posts a numbers-only summary.
ANTHROPIC_API_KEY=

# Right-click the channel / server -> Copy ID (turn on Developer Mode in Discord settings first).
# SKI_GUILD_ID makes /skibrief appear instantly in that server.
SKI_CHANNEL_ID=
SKI_GUILD_ID=

# Weekly auto-post (only if SKI_CHANNEL_ID is set)
SKI_POST_DAY=thu
SKI_POST_TIME=18:00
SKI_TIMEZONE=America/Vancouver
