# Copy to activate-brief.env and fill in. Never commit the real file.

# Discord developer portal -> New Application -> Bot -> Reset Token. Use a separate application from
# the ski bot. Invite it with the "bot" + "applications.commands" scopes (OAuth2 -> URL Generator),
# permissions: Send Messages.
DISCORD_BOT_TOKEN=

# Where the Activate tracker is served. Empty means https://activate.noobatron.duckdns.org, but that
# times out from inside TrueNAS (the router doesn't loop the public IP back), so on the NAS use the
# tracker's LAN address and published port.
ACTIVATE_URL=http://192.168.1.82:8420

# "Last N days" window for points, visits and discount (1-365).
ACTIVATE_DAYS=30

# Right-click the channel / server -> Copy ID (turn on Developer Mode in Discord settings first).
# ACTIVATE_GUILD_ID makes /roast appear instantly in that server.
ACTIVATE_CHANNEL_ID=
ACTIVATE_GUILD_ID=

# Weekly auto-post (only if ACTIVATE_CHANNEL_ID is set)
ACTIVATE_POST_DAY=mon
ACTIVATE_POST_TIME=18:00
ACTIVATE_TIMEZONE=America/Vancouver
